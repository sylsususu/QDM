		for (int j = 0; j < 8; j++)
		{
			result += paraWithMag[j * 3] * exp(-pow(x_Vec[i] - paraWithMag[j * 3 + 1], 2) / paraWithMag[j * 3 + 2]);
		}
		result += paraWithMag[24];
		resultDataList.push_back(result);
	}
