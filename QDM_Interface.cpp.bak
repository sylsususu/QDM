			}
			else
			{
				ui.pushButton_Forward->setEnabled(true);
				ui.pushButton_Backward->setEnabled(true);
			}
		}
		else
		{
			ui.pushButton_Left->setEnabled(true);
			ui.pushButton_Right->setEnabled(true);
		}
	}


}

