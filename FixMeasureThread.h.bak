#pragma once
#include <QThread>
#include"CameraDataProcess.h"
#include<qmetatype.h>
class FixMeasureThread :public QThread
{
    Q_OBJECT
public:
    explicit FixMeasureThread(QObject* parent = 0);

public:
    void run();
    void stream();
    void pause();
    void stop();
    void ProcessData(unsigned char* rawBuffer, double fre);
    void setSavePath(QString);
public:
    bool pause_status;
    bool quit;

    cv::Mat onMat, offMat;
    int picNum;
    int iterTime;
    QString savePath;
signals:
    void GetMat(cv::Mat);
    void stopFixMeasure();
};

