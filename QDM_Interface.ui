    <property name="styleSheet">
     <string notr="true">QTableWidget{
   border: 0px ;  /* 设置边框样式 */
    background-color: #1E1E1E;  /* 设置背景颜色 */
    selection-background-color: #FF0000;  /* 设置选中背景颜色 */
    selection-color: #FFFFFF;  /* 设置选中文本颜色 */
    alternate-background-color: #1E1E1E;  /* 设置交替行背景颜色 */
}



QTableWidget::item:hover { 
    background-color: #333333;  /* 设置鼠标悬停时的背景颜色 */
    color: #FFFFFF;  /* 设置鼠标悬停时的文本颜色 */
}

QHeaderView::section {
    background-color: #1E1E1E;  /* 设置表头的背景颜色 */
    color: white;  /* 设置表头文本颜色 */
    border: 0px solid;  /* 设置边框为无 */
    border-radius: 0px;  /* 设置边框圆角半径为0 */
    padding: 2px 4px;  /* 设置内边距 */
    width: 20;  /* 设置宽度 */
    height: 20;  /* 设置高度为15px */
    text-align: Center;  /* 设置文本居中对齐 */
    font-size: 15px;  /* 设置字体大小 */
}

QTableWidget::item {
    color: white;  /* 设置文本颜色 */
    border: 1px solid #979797;  /* 设置边框样式 */
    border-bottom: 1px solid #979797;  /* 设置底部边框样式 */
    border-top: 1px solid #979797;  /* 设置顶部边框样式 */
    border-left: 1px solid #979797;  /* 设置左侧边框样式 */
    text-align: Center;  /* 设置文本居中对齐 */
	
}
QTableCornerButton:section{
	background: #1E1E1E;/* 设置表头交叉部分的背景颜色 */

}
QTableWidget QLineEdit { color: white; }</string>
