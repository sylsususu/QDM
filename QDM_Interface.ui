   <property name="styleSheet">
    <string notr="true">QHeaderView::section { 
    height:25px;  /* 设置section的高度 */
    color:white;  /* 设置文字颜色 */
    background: #191919;  /* 设置背景颜色 */
   
}

QTreeWidget {
    border:none;  /* 移除边框 */
    background: #060606;  /* 设置背景颜色 */
    show-decoration-selected: 0;  /* 显示选中项的装饰 */
	
}


QTreeWidget::item {
   
	margin-bottom: 10px;  /* 设置下边距 */
    border: none;  /* 移除边框 */
    height: 56px;  /* 设置高度 */
    color: white;  /* 设置文字颜色 */
    background: #191919;  /* 设置背景颜色 */
	
	background-image:url(:/Image/treeclose.png); background-repeat: no-repeat; 
background-position: right ; 
	
}

QTreeWidget::item:hover {
    border: none;  /* 移除边框 */
    background: #3B3B3B;  /* 设置鼠标悬停时的背景颜色 */
}

QTreeWidget::item:selected{
    border: none;  /* 移除边框 */
    background: #3B3B3B;  /* 设置选中项的背景颜色 */
}



QTreeWidget::branch {
	
    border: none;  /* 移除边框 */
    background:  #060606;  /* 设置展开/折叠控件的背景颜色 */
}

QTreeWidget::item:closed {background-image: url(:/Image/treeclose.png); background-repeat: no-repeat; 
background-position: right ; 
 }
QTreeWidget::item:open { background-image: url(:./Image/treeopen.png); background-repeat: no-repeat; 
background-position: right ; 
 }

QTreeWidget::branch:hover {
    border: none;  /* 移除边框 */
    background: #060606;  /* 设置鼠标悬停时的背景颜色 */
}

QTreeWidget::branch:selected {
    border: none;  /* 移除边框 */
    background: #060606;  /* 设置选中项的背景颜色 */
	
}
</string>
